Window.SetBackgroundTopColor(0.078, 0.078, 0.086);
Window.SetBackgroundBottomColor(0.078, 0.078, 0.086);

logo.image = Image("datamint-splash-logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);

bar.image = Image("datamint-splash-bar.png");
bar.sprite = Sprite();
bar.width = Window.GetWidth() / 4;
bar.x = Window.GetX() + Window.GetWidth() / 2 - bar.width / 2;
bar.y = logo.y + logo.image.GetHeight() + 50;
bar.sprite.SetPosition(bar.x, bar.y, 10);

frame = 0;

fun refresh_callback() {
  frame = frame + 1;
  logo.sprite.SetOpacity(0.7 + 0.3 * Math.Sin(frame / 20.0));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
  w = Math.Int(bar.width * progress);
  if (w < 1) {
    w = 1;
  }
  bar.sprite.SetImage(bar.image.Scale(w, 6));
}
Plymouth.SetBootProgressFunction(progress_callback);
