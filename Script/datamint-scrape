#!/bin/bash
# datamint-scrape : membuat proyek web scraping lengkap dengan template siap pakai
set -e

if [ -z "$1" ]; then
  echo "Pemakaian: datamint-scrape nama-proyek"
  exit 1
fi

NAME="$1"
datamint-new "$NAME"
cd "$NAME"
mkdir -p scrapers output

cat > scrapers/contoh_bs4.py <<'PY'
import requests
from bs4 import BeautifulSoup

r = requests.get("https://quotes.toscrape.com/", timeout=30)
soup = BeautifulSoup(r.text, "lxml")
for q in soup.select("div.quote"):
    print(q.select_one("span.text").get_text(strip=True))
PY

cat > scrapers/contoh_selenium.py <<'PY'
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.firefox.options import Options

opt = Options()
opt.add_argument("-headless")
driver = webdriver.Firefox(options=opt)
driver.get("https://quotes.toscrape.com/js/")
for el in driver.find_elements(By.CSS_SELECTOR, "span.text"):
    print(el.text)
driver.quit()
PY

cat > scrapers/contoh_playwright.py <<'PY'
from playwright.sync_api import sync_playwright

with sync_playwright() as p:
    browser = p.chromium.launch()
    page = browser.new_page()
    page.goto("https://quotes.toscrape.com/js/")
    print(page.locator("span.text").all_inner_texts())
    browser.close()
PY

cat > scrapers/simpan_duckdb.py <<'PY'
import duckdb
import pandas as pd

df = pd.DataFrame({"kutipan": ["contoh data"], "penulis": ["anonim"]})
con = duckdb.connect("output/hasil.duckdb")
con.execute("CREATE OR REPLACE TABLE kutipan AS SELECT * FROM df")
print(con.execute("SELECT * FROM kutipan").fetchall())
PY

/opt/datamint-venv/bin/scrapy startproject crawler scrapers/scrapy_crawler > /dev/null 2>&1 || true

printf '\n## Template scraping\n- scrapers/contoh_bs4.py : situs statis (BeautifulSoup)\n- scrapers/contoh_selenium.py : situs dinamis (Selenium + Firefox)\n- scrapers/contoh_playwright.py : situs dinamis (Playwright)\n- scrapers/simpan_duckdb.py : simpan hasil ke DuckDB\n- scrapers/scrapy_crawler : kerangka proyek Scrapy\n- output : hasil scraping\n' >> README.md

echo "Proyek scraping '$NAME' siap. Coba: python scrapers/contoh_bs4.py"
